{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "index.ts",
    "mobile/**/*.ts",
    "mobile/**/*.tsx",
    "shared/**/*.ts",
    "worker/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src",
    "tests",
    "verification"
  ]
}
